<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_light_red"
                    android:contentDescription="@string/cd_custo_icon"
                    android:padding="8dp"
                    app:srcCompat="@drawable/ic_receipt_long"
                    app:tint="@color/delta_negative" />

                <TextView
                    android:id="@+id/txtTituloModalCusto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/custo_modal_titulo_novo"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnFecharModalCusto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/custo_btn_cancelar"
                    android:padding="8dp"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/custo_label_descricao"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edDescricaoCusto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/campo"
                android:hint="@string/custo_hint_descricao"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSugestoesCusto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSugestaoCombustivel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/custo_chip_combustivel"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/surface_subtle"
                        app:chipStrokeColor="@color/border_subtle"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSugestaoManutencao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/custo_chip_manutencao"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/surface_subtle"
                        app:chipStrokeColor="@color/border_subtle"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSugestaoPedagio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/custo_chip_pedagio"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/surface_subtle"
                        app:chipStrokeColor="@color/border_subtle"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSugestaoLavagem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/custo_chip_lavagem"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/surface_subtle"
                        app:chipStrokeColor="@color/border_subtle"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSugestaoSeguro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/custo_chip_seguro"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/surface_subtle"
                        app:chipStrokeColor="@color/border_subtle"
                        app:chipStrokeWidth="1dp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/custo_label_valor"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edValorCusto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/campo"
                android:digits="0123456789.,"
                android:hint="@string/custo_hint_valor"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/custo_label_data"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edDataCusto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/campo"
                    android:digits="0123456789/"
                    android:hint="@string/custo_hint_data"
                    android:inputType="date"
                    android:maxLength="10"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnSelecionarDataCusto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_selecionar_data_custo"
                    android:padding="10dp"
                    app:srcCompat="@drawable/ic_calendar_today"
                    app:tint="@color/brand_green_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCancelarCusto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bt_secondary_selector"
                    android:text="@string/custo_btn_cancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSalvarCusto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bt_green_selector"
                    android:text="@string/custo_btn_salvar"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
