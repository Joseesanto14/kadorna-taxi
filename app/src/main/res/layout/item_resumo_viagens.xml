<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtDataHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="dd/MM • HH:MM"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnEditarViagem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_editar_viagem"
            android:src="@drawable/ic_edit"
            app:layout_constraintBottom_toBottomOf="@+id/txtValorTotal"
            app:layout_constraintEnd_toStartOf="@+id/btnExcluirViagem"
            app:layout_constraintTop_toTopOf="@+id/txtValorTotal" />

        <ImageButton
            android:id="@+id/btnExcluirViagem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_excluir_viagem"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="@+id/txtValorTotal"
            app:layout_constraintEnd_toStartOf="@+id/txtValorTotal"
            app:layout_constraintTop_toTopOf="@+id/txtValorTotal" />

        <TextView
            android:id="@+id/txtValorTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 00,00"
            android:textColor="#2E7D32"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/dividerHeader"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F0F0F0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtDataHora" />

        <ImageView
            android:id="@+id/iconOrigem"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="12dp"
            android:src="@android:drawable/btn_radio"
            app:tint="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dividerHeader" />

        <TextView
            android:id="@+id/txtOrigem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Local de Origem, 000"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/iconOrigem"
            app:layout_constraintEnd_toStartOf="@+id/containerBadgesDireita"
            app:layout_constraintStart_toEndOf="@+id/iconOrigem"
            app:layout_constraintTop_toTopOf="@+id/iconOrigem" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="#BDBDBD"
            app:layout_constraintStart_toStartOf="@+id/iconOrigem"
            app:layout_constraintEnd_toEndOf="@+id/iconOrigem"
            app:layout_constraintTop_toBottomOf="@+id/iconOrigem"
            app:layout_constraintBottom_toTopOf="@+id/iconDestino"/>

        <ImageView
            android:id="@+id/iconDestino"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iconOrigem" />

        <TextView
            android:id="@+id/txtDestino"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Local de Destino"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/iconDestino"
            app:layout_constraintEnd_toStartOf="@+id/containerBadgesDireita"
            app:layout_constraintStart_toEndOf="@+id/iconDestino"
            app:layout_constraintTop_toTopOf="@+id/iconDestino" />

        <LinearLayout
            android:id="@+id/containerBadgesDireita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iconOrigem">

            <TextView
                android:id="@+id/txtKmsRodados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_gray"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="00.0 km"
                android:textColor="#616161"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtQtdServicos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_gray"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="0 serviços"
                android:textColor="#616161"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierTrajeto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="iconDestino,txtDestino,containerBadgesDireita" />

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:gravity="top"
            android:maxLines="3"
            android:text="Descrição referente a viagem"
            android:textColor="#757575"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/txtSolicitante"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrierTrajeto" />

        <TextView
            android:id="@+id/txtSolicitante"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Solicitante: Nome"
            android:textColor="#424242"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtDescricao"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>